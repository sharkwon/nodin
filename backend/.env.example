# Backend port (default 3000)
PORT=3000

# API route prefix
API_PREFIX=/api

# CORS origin ("*" for open, or a specific origin)
CORS_ORIGIN=*

# Solana RPC endpoint — defaults to public mainnet RPC.
# For higher rate limits use a provider endpoint, e.g. Helius:
# SOLANA_RPC_URL=https://mainnet.helius-rpc.com/?api-key=YOUR_KEY
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# Optional: enables the Dune Analytics connector (DAA, tx volume).
# Without it, the Dune section is omitted (no fabricated fallback).
# DUNE_API_KEY=
